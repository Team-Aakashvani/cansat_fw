# ===========================================================================
# sdkconfig.defaults — ESP32-S3 release configuration
# CAN-7USAT 2026 Flight Software
#
# sdkconfig is git-ignored, so this file is the ONLY build configuration a
# fresh clone gets. Keep it in sync with the configuration flashed on the board.
# Note: defaults only apply to keys missing from an existing sdkconfig; after
# editing this file, delete sdkconfig (or run `idf.py reconfigure` from clean).
# ===========================================================================

# ---- Target ---------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"

# ---- CPU & Clock ----------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ---- Flash ----------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- FreeRTOS SMP ---------------------------------------------------------
# 1 kHz tick: the 10 ms IMU/nav and 20 ms telemetry periods are exact
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# ---- Watchdog -------------------------------------------------------------
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=300

# ---- Brownout Detection ---------------------------------------------------
CONFIG_ESP_BROWNOUT_DET=y

# ---- Logging --------------------------------------------------------------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Role -----------------------------------------------------------------
CONFIG_ROLE_FC=y
CONFIG_BIT_DEBUG_BYPASS=y

# ---- Console: native USB Serial/JTAG (the board's USB COM port) -----------
# Primary console = USB-JTAG so stdin works (dock/CLI commands: CX, ST, TARE...).
# As a *secondary* console USB-JTAG is output-only and every command is dropped.
# main.cpp installs the buffered usb_serial_jtag driver, so printf never
# busy-waits; with no host attached, output is dropped after a 50 ms timeout.
# UART0 (GPIO43/44) carries no logs after boot.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
